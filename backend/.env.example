PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/subsense
# Comma-separated list of trusted frontend origins (credentialed CORS + Origin check).
CLIENT_ORIGIN=http://localhost:5173

# --- Phase 4.1 authentication ---
# Session lifetime in hours (default 168 = 7 days).
SESSION_TTL_HOURS=168
# lax (default) | strict | none. Use "none" only when the frontend is on a different site
# than the API; it requires Secure cookies (NODE_ENV=production or COOKIE_SECURE=true).
COOKIE_SAMESITE=lax
# Secure cookies are always on when NODE_ENV=production.
# COOKIE_SECURE=true
# Auth rate limit: max login/register attempts per IP (and per account for login) per window.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Set when running behind a reverse proxy so rate limiting sees the client IP (e.g. 1).
# TRUST_PROXY=1
