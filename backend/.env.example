# SubSense API configuration. Copy to backend/.env for local development (backend/.env is
# git-ignored). NEVER commit a real .env, and never put these values in the frontend.
# Validate a configuration without starting the server:  npm run check:config
#
# ============================== DEVELOPMENT (defaults shown) ==============================
PORT=5000
# Local MongoDB or a DEVELOPMENT Atlas database. Must start with mongodb:// or mongodb+srv://.
MONGO_URI=mongodb://127.0.0.1:27017/subsense_dev
# Comma-separated list of exact trusted frontend origins (credentialed CORS + Origin check).
# No wildcards, no paths. Default: http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Session lifetime in hours (default 168 = 7 days, maximum 2160 = 90 days).
SESSION_TTL_HOURS=168
# lax (default) | strict | none. "none" makes the session a third-party cookie when the frontend
# and API are on different sites; it requires Secure cookies and still fails in browsers that block
# third-party cookies. Prefer a same-origin /api proxy (see PHASE_5_1_PRODUCTION_READINESS.md).
COOKIE_SAMESITE=lax
# Secure cookies are always on when NODE_ENV=production (COOKIE_SECURE=false is rejected there).
# COOKIE_SECURE=true
# Auth rate limit: max login/register attempts per client IP (and per account for login) per window.
# Whole numbers only (max 1-10000, window 1000-86400000 ms); invalid values stop the server.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Number of reverse proxies in front of the API (hop count), or presets/IPs/CIDRs such as
# "loopback" or "10.0.0.0/8". Leave unset locally. "true" is rejected (lets clients spoof their IP).
# TRUST_PROXY=1

# ======================= DISPOSABLE INTEGRATION TESTS (real MongoDB) =======================
# Only read by `npm run test:mongo`. MONGO_URI is NEVER used for tests. The database name must
# start with "subsense_test"; each run creates and drops its own "<name>_r<random>" database.
# Prefer `npm run test:mongo:local`, which starts a throwaway local mongod and needs none of these.
# SUBSENSE_REAL_DB_TESTS=1
# TEST_MONGO_URI=mongodb://127.0.0.1:27017/subsense_test
# Only for a dedicated, disposable remote test cluster (never the production cluster/database):
# SUBSENSE_REAL_DB_ALLOW_REMOTE=1
# Optional: also wait ~60-140 s to observe MongoDB's TTL monitor delete an expired session.
# SUBSENSE_REAL_DB_TTL_WAIT=1

# ===================================== PRODUCTION =====================================
# Set these in the hosting dashboard (e.g. Render), not in a committed file:
#   NODE_ENV=production
#   MONGO_URI=mongodb+srv://<least-privilege-user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
#   CLIENT_ORIGIN=https://<frontend-origin>        (required; https only)
#   TRUST_PROXY=1                                   (Render: one proxy hop)
#   COOKIE_SAMESITE=lax                             (with the same-origin /api proxy)
#   SESSION_TTL_HOURS=168
#   AUTH_RATE_LIMIT_MAX=20
#   AUTH_RATE_LIMIT_WINDOW_MS=900000
# PORT is provided by the host.
